{
  "name": "teamsync-pdf-viewer",
  "version": "1.3.3",
  "license": "CPAL-1.0",
  "description": "TeamSync PDF Viewer SDK — client-side PDF viewing, annotation, search, redaction and watermarking for React.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/teamsync-pdf-viewer.js",
  "module": "./dist/teamsync-pdf-viewer.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/teamsync-pdf-viewer.js",
      "default": "./dist/teamsync-pdf-viewer.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pdf",
    "pdf-viewer",
    "react",
    "pdfjs",
    "annotations",
    "redaction",
    "watermark",
    "teamsync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelbot-ai/TeamSync-PDF-Viewer.git"
  },
  "bugs": {
    "url": "https://github.com/angelbot-ai/TeamSync-PDF-Viewer/issues"
  },
  "homepage": "https://github.com/angelbot-ai/TeamSync-PDF-Viewer#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --config vite.config.app.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.2.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "pdfjs-dist": "^6.2.108",
    "publint": "^0.3.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.11"
  }
}
