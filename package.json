{
  "name": "@angelbot-ai-pvt-ltd/teamsync-pdf-viewer",
  "version": "2.2.7",
  "license": "CPAL-1.0",
  "description": "TeamSync PDF Viewer SDK — client-side PDF viewing, annotation, search, redaction and watermarking for React.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/teamsync-pdf-viewer.js",
  "module": "./dist/teamsync-pdf-viewer.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/teamsync-pdf-viewer.js",
      "default": "./dist/teamsync-pdf-viewer.js"
    },
    "./office": {
      "types": "./dist/src/office/index.d.ts",
      "import": "./dist/teamsync-pdf-viewer.js",
      "default": "./dist/teamsync-pdf-viewer.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "office.js",
    "office.d.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pdf",
    "pdf-viewer",
    "react",
    "pdfjs",
    "annotations",
    "redaction",
    "watermark",
    "teamsync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://git.teamsync.link/angelbot-ai-pvt-ltd/teamsync-pdf-viewer.git"
  },
  "bugs": {
    "url": "https://git.teamsync.link/angelbot-ai-pvt-ltd/teamsync-pdf-viewer/issues"
  },
  "homepage": "https://git.teamsync.link/angelbot-ai-pvt-ltd/teamsync-pdf-viewer",
  "publishConfig": {
    "registry": "https://git.teamsync.link/api/packages/angelbot-ai-pvt-ltd/npm/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "sync:version": "node scripts/sync-version.mjs",
    "typecheck": "tsc -b",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc -b && vite build",
    "prebuild:app": "node scripts/sync-version.mjs",
    "build:app": "tsc -b && vite build --config vite.config.app.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.2.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.80.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "pdfjs-dist": "^6.5.438",
    "publint": "^0.3.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "undici": "^8.12.3",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2"
  }
}
