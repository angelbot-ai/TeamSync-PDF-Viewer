{
  "name": "@angelbot-ai/teamsync-pdf-viewer",
  "version": "1.0.1",
  "license": "CPAL-1.0",
  "description": "Enterprise PDF Viewer SDK - 100% Client-Side WebAssembly PDF Engine for React",
  "type": "module",
