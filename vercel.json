{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:app",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/convert",
      "destination": "https://teamsync-office-converter-1.onrender.com/forms/libreoffice/convert"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
